          "feature": "baseline_change",
          "operator": "gt",
          "threshold": 0.3,
          "points": 40,
          "level": 2,
          "window": 3
        },
        {
          "id": "reported-symptoms",
          "metric": "symptoms",
          "feature": "count",
          "operator": "gt",
          "threshold": 0,
          "points": 60,
          "level": 2
        }
      ]
    },
    "behavioral": {
      "bands": [
        {
          "min_points": 0,
          "level": 0
        },
        {
          "min_points": 20,
          "level": 1
