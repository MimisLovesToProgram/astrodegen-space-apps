        {
          "min_points": 50,
          "level": 2
        },
        {
          "min_points": 80,
          "level": 3
        }
      ],
      "rules": [
        {
          "id": "mood-demo",
          "metric": "mood",
          "feature": "value",
          "operator": "lte",
          "threshold": 2,
          "points": 35,
          "level": 2
